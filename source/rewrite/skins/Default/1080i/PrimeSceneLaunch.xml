<?xml version="1.0" encoding="utf-8"?>
<window>
    <zorder>20</zorder>
    <!-- Closing dialogs allow the main window to activate. Keep this cover
         opaque until interface_ready force-closes it over the identical art. -->
    <animation effect="fade" start="100" end="100" time="60000">WindowClose</animation>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>splash.png</texture>
        </control>
    </controls>
</window>

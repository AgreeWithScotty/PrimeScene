<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">310</defaultcontrol>
    <animation effect="fade" start="0" end="100" time="280">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>white.png</texture>
            <colordiffuse>FF171C21</colordiffuse>
        </control>
        <control type="image" id="100">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>760</height>
            <fadetime>80</fadetime>
            <aspectratio align="center" aligny="top">scale</aspectratio>
            <texture background="true">$INFO[Window.Property(HeroFanart)]</texture>
            <visible>!String.IsEmpty(Window.Property(HeroFanart))</visible>
        </control>
        <control type="image" id="101">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>760</height>
            <texture>white.png</texture>
            <colordiffuse>99141A20</colordiffuse>
        </control>
        <control type="image">
            <left>0</left>
            <top>420</top>
            <width>1920</width>
            <height>360</height>
            <texture>vignette.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>700</top>
            <width>1920</width>
            <height>380</height>
            <texture>white.png</texture>
            <colordiffuse>FF171C21</colordiffuse>
        </control>
        <control type="label">
            <left>72</left>
            <top>36</top>
            <width>640</width>
            <height>28</height>
            <font>Wordmark</font>
            <textcolor>FFE6E8EB</textcolor>
            <label>P R I M E   S C E N E</label>
        </control>
        <control type="label">
            <left>76</left>
            <top>168</top>
            <width>1200</width>
            <height>28</height>
            <font>Kicker</font>
            <textcolor>FFD5DAE0</textcolor>
            <label>$INFO[Window.Property(Kicker)]</label>
        </control>
        <control type="label">
            <left>72</left>
            <top>196</top>
            <width>1500</width>
            <height>120</height>
            <font>Hero</font>
            <textcolor>FFF7F8F8</textcolor>
            <label>$INFO[Window.Property(HeroTitle)]</label>
        </control>
        <control type="label">
            <left>76</left>
            <top>324</top>
            <width>1100</width>
            <height>32</height>
            <font>Tag</font>
            <textcolor>FFE4E7EB</textcolor>
            <label>$INFO[Window.Property(Meta)]</label>
        </control>
        <control type="label">
            <left>76</left>
            <top>364</top>
            <width>900</width>
            <height>96</height>
            <font>Body</font>
            <textcolor>FFC9D0D6</textcolor>
            <label>$INFO[Window.Property(Synopsis)]</label>
            <wrap>true</wrap>
        </control>
        <control type="button" id="310">
            <left>72</left>
            <top>476</top>
            <width>240</width>
            <height>56</height>
            <font>Button</font>
            <label>WATCH NOW</label>
            <align>center</align>
            <textoffsetx>0</textoffsetx>
            <textcolor>FFE8EAED</textcolor>
            <focusedcolor>FF14181C</focusedcolor>
            <texturefocus border="14">button-focus.png</texturefocus>
            <texturenofocus border="14">button-idle.png</texturenofocus>
        </control>
        <control type="label">
            <left>76</left>
            <top>640</top>
            <width>600</width>
            <height>28</height>
            <font>Section</font>
            <textcolor>FFC5CCD3</textcolor>
            <label>MORE TO WATCH</label>
            <visible>Integer.IsGreater(Container(210).NumItems,0)</visible>
        </control>
        <control type="fixedlist" id="210">
            <left>64</left>
            <top>680</top>
            <width>1820</width>
            <height>370</height>
            <orientation>horizontal</orientation>
            <focusposition>0</focusposition>
            <scrolltime>160</scrolltime>
            <onup>310</onup>
            <itemlayout width="440" height="350">
                <control type="image">
                    <left>8</left>
                    <top>12</top>
                    <width>408</width>
                    <height>220</height>
                    <aspectratio>scale</aspectratio>
                    <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                    <bordertexture>grey.png</bordertexture>
                    <bordersize>1</bordersize>
                    <colordiffuse>A6FFFFFF</colordiffuse>
                </control>
                <control type="label">
                    <left>10</left>
                    <top>242</top>
                    <width>404</width>
                    <height>32</height>
                    <font>Card</font>
                    <textcolor>FFB7BEC6</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>10</left>
                    <top>274</top>
                    <width>404</width>
                    <height>28</height>
                    <font>Meta</font>
                    <textcolor>FF8E979F</textcolor>
                    <label>$INFO[ListItem.Property(Meta)]</label>
                </control>
                <control type="progress">
                    <left>10</left>
                    <top>310</top>
                    <width>404</width>
                    <height>3</height>
                    <info>ListItem.PercentPlayed</info>
                    <visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
                    <texturebg>grey.png</texturebg>
                    <midtexture>white.png</midtexture>
                </control>
            </itemlayout>
            <focusedlayout width="440" height="350">
                <control type="group">
                    <animation effect="zoom" start="100" end="106" center="212,122" time="160" tween="quadratic" easing="out" reversible="false">Focus</animation>
                    <animation effect="slide" end="0,-12" time="160" tween="quadratic" easing="out" reversible="false">Focus</animation>
                    <control type="image">
                        <left>8</left>
                        <top>12</top>
                        <width>408</width>
                        <height>220</height>
                        <aspectratio>scale</aspectratio>
                        <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                        <bordertexture>white.png</bordertexture>
                        <bordersize>4</bordersize>
                    </control>
                    <control type="label">
                        <left>10</left>
                        <top>242</top>
                        <width>404</width>
                        <height>32</height>
                        <font>Card</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <left>10</left>
                        <top>274</top>
                        <width>404</width>
                        <height>28</height>
                        <font>Meta</font>
                        <textcolor>FFE6E8EB</textcolor>
                        <label>$INFO[ListItem.Property(Meta)]</label>
                    </control>
                    <control type="progress">
                        <left>10</left>
                        <top>310</top>
                        <width>404</width>
                        <height>3</height>
                        <info>ListItem.PercentPlayed</info>
                        <visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
                        <texturebg>grey.png</texturebg>
                        <midtexture>white.png</midtexture>
                    </control>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>

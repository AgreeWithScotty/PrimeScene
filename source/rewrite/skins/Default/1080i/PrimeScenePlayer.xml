<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">501</defaultcontrol>
    <animation effect="fade" start="0" end="100" time="280">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
    <controls>
        <control type="group">
            <visible>String.IsEqual(Window.Property(Chrome),1)</visible>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>1920</width>
                <height>1080</height>
                <texture>dim.png</texture>
            </control>
            <control type="label">
                <left>80</left>
                <top>72</top>
                <width>1400</width>
                <height>64</height>
                <font>PlayerTitle</font>
                <textcolor>FFF4F1EA</textcolor>
                <label>$INFO[Window.Property(Title)]</label>
            </control>
            <control type="label">
                <left>82</left>
                <top>142</top>
                <width>1000</width>
                <height>28</height>
                <font>Tag</font>
                <textcolor>FF8A8A8A</textcolor>
                <label>$INFO[Window.Property(Meta)]</label>
            </control>
            <control type="label" id="410">
                <left>80</left>
                <top>860</top>
                <width>160</width>
                <height>24</height>
                <font>Time</font>
                <textcolor>FFF4F1EA</textcolor>
                <label>$INFO[Window.Property(Elapsed)]</label>
            </control>
            <control type="label" id="411">
                <left>1680</left>
                <top>860</top>
                <width>160</width>
                <height>24</height>
                <font>Time</font>
                <align>right</align>
                <textcolor>FFF4F1EA</textcolor>
                <label>$INFO[Window.Property(Total)]</label>
            </control>
            <control type="progress" id="400">
                <left>80</left>
                <top>896</top>
                <width>1760</width>
                <height>2</height>
                <texturebg>grey.png</texturebg>
                <midtexture>white.png</midtexture>
            </control>
            <control type="button" id="500">
                <left>768</left>
                <top>940</top>
                <width>72</width>
                <height>72</height>
                <texturefocus>prev.png</texturefocus>
                <texturenofocus>prev.png</texturenofocus>
                <onleft>500</onleft>
                <onright>501</onright>
                <onup>400</onup>
                <ondown>504</ondown>
            </control>
            <control type="button" id="501">
                <left>872</left>
                <top>940</top>
                <width>72</width>
                <height>72</height>
                <texturefocus>pause.png</texturefocus>
                <texturenofocus>pause.png</texturenofocus>
                <onleft>500</onleft>
                <onright>503</onright>
                <onup>400</onup>
                <ondown>504</ondown>
            </control>
            <control type="button" id="503">
                <left>976</left>
                <top>940</top>
                <width>72</width>
                <height>72</height>
                <texturefocus>stop.png</texturefocus>
                <texturenofocus>stop.png</texturenofocus>
                <onleft>501</onleft>
                <onright>502</onright>
                <onup>400</onup>
                <ondown>504</ondown>
            </control>
            <control type="button" id="502">
                <left>1080</left>
                <top>940</top>
                <width>72</width>
                <height>72</height>
                <texturefocus>next.png</texturefocus>
                <texturenofocus>next.png</texturenofocus>
                <onleft>503</onleft>
                <onright>502</onright>
                <onup>400</onup>
                <ondown>505</ondown>
            </control>
            <control type="button" id="504">
                <left>80</left>
                <top>940</top>
                <width>72</width>
                <height>72</height>
                <texturefocus>subtitles.png</texturefocus>
                <texturenofocus>subtitles.png</texturenofocus>
                <visible>String.IsEqual(Window.Property(HasSubtitles),1)</visible>
                <onright>505</onright>
                <onup>501</onup>
            </control>
            <control type="button" id="505">
                <left>164</left>
                <top>940</top>
                <width>72</width>
                <height>72</height>
                <texturefocus>audio.png</texturefocus>
                <texturenofocus>audio.png</texturenofocus>
                <visible>String.IsEqual(Window.Property(HasAudio),1)</visible>
                <onleft>504</onleft>
                <onup>501</onup>
            </control>
            <control type="image">
                <left>1588</left>
                <top>962</top>
                <width>36</width>
                <height>36</height>
                <texture>speaker.png</texture>
            </control>
            <control type="progress" id="520">
                <left>1640</left>
                <top>978</top>
                <width>200</width>
                <height>2</height>
                <texturebg>grey.png</texturebg>
                <midtexture>white.png</midtexture>
            </control>
        </control>
    </controls>
</window>

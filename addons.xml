<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="plugin.video.primeinterface" name="Smooth Prime" version="0.2.7" provider-name="AgreeWithScotty">
  <requires>
    <import addon="xbmc.python" version="3.0.1" />
    <import addon="script.module.beautifulsoup4" version="4.6.3+matrix.1" />
    <import addon="script.module.mechanicalsoup" version="0.12.0+matrix.1" />
    <import addon="script.module.pyxbmct" version="1.3.1+matrix.1" />
    <import addon="script.module.inputstreamhelper" version="0.4.4+matrix.1" />
    <import addon="script.module.requests" version="2.22.0+matrix.1" />
    <import addon="script.module.pyautogui" version="0.9.49+matrix.1" />
    <import addon="script.module.amazoncaptcha" version="0.5.11+matrix.1" />
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <reuselanguageinvoker>false</reuselanguageinvoker>
    <license>GPL-3.0-or-later</license>
    <source>https://github.com/AgreeWithScotty/PrimeScene</source>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
    <summary lang="en_GB">Smooth Prime: Prime Video in the Aurora Cinema interface</summary>
    <description lang="en_GB">Smooth Prime is a Prime Video add-on maintained by AgreeWithScotty. Aurora Cinema is the home and player screen. Website sign-in and the storefront reader use your own account. Includes GPL-3.0-or-later backend code derived from Sandmann79/xbmc. See NOTICE.md for upstream credits. Not affiliated with Amazon.</description>
    <disclaimer lang="en_GB">Uses your own Amazon account. Playback uses this add-on's existing player path and Kodi inputstream. Not affiliated with Amazon.</disclaimer>
    <news>0.2.7[CR]- Rebranded to Smooth Prime; new icon; removed Amazon logo asset.</news>
  </extension>
</addon>
  <addon id="repository.primescene" name="Prime Scene Repository" version="0.1.2" provider-name="Prime Scene contributors">
    <requires>
      <import addon="xbmc.addon" version="21.0.0"/>
    </requires>
    <extension point="xbmc.addon.repository" name="Prime Scene Repository">
      <dir>
        <info compressed="false">https://agreewithscotty.github.io/ScottyWins/addons.xml</info>
        <checksum verify="md5">https://agreewithscotty.github.io/ScottyWins/addons.xml.md5</checksum>
        <datadir zip="true">https://agreewithscotty.github.io/ScottyWins/</datadir>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Prime Scene releases and updates</summary>
      <description lang="en_GB">Delivers updates for the standalone Prime Scene add-on. The index is now hosted by ScottyWins.</description>
      <platform>all</platform>
      <license>GPL-3.0-or-later</license>
      <source>https://github.com/AgreeWithScotty/ScottyWins</source>
      <news>0.1.2[CR]- Repository index moved to ScottyWins.</news>
      <assets>
        <icon>icon.png</icon>
      </assets>
    </extension>
  </addon>
  </addons>
